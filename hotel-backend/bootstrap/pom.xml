<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>id.co.hospitops</groupId>
        <artifactId>hotel-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bootstrap</artifactId>
    <name>HospitOps Bootstrap — Runnable App</name>

    <!--
        This is the ONLY deployable module.
        All other modules are libraries assembled here.

        JVM run:     mvn spring-boot:run -pl bootstrap -am
        Fat JAR:     mvn package -pl bootstrap -am
        Native bin:  mvn -Pnative native:compile -pl bootstrap -am
        Native img:  mvn -Pnative spring-boot:build-image -pl bootstrap -am
        Deploy:      kubectl apply -f k8s/
    -->

    <dependencies>
        <!-- ── All bounded context modules ─────────────────── -->
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>shared</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>group</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>hotel</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>identity</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>room</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>guest</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>reservation</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>housekeeping</artifactId>
        </dependency>
        <dependency>
            <groupId>id.co.hospitops</groupId>
            <artifactId>billing</artifactId>
        </dependency>

        <!-- ── Infrastructure ───────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <!--
                Actuator exposes /actuator/health/liveness
                and /actuator/health/readiness for K8s probes.
            -->
        </dependency>

        <!--
            R3 FIX: Required for AuditLoggingAspect (@Aspect, @Around).
            spring-boot-starter-aop was removed in Spring Boot 4.0 — AOP
            autoconfiguration is now part of spring-boot-autoconfigure.
            Only aspectjweaver (the AspectJ runtime) needs to be declared
            explicitly; spring-aop is pulled in transitively via spring-context.
            Version is managed by the inherited Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!--
            R-02 FIX: Redis-backed token blacklist for multi-replica deployments.
            Activated when hospitops.redis.enabled=true; falls back to the
            InMemoryTokenBlacklist when Redis is absent (local/test).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            Spring Boot 4.0 split autoconfiguration into individual modules.
            spring-boot-flyway registers FlywayAutoConfiguration so Spring Boot
            actually wires up Flyway. Without it, flyway-core is on the classpath
            but Spring Boot never creates the Flyway bean — no migrations run,
            Hibernate validates an empty schema, and the app fails to start.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- ── Dev only ──────────────────────────────────────── -->
        <!--
            No spring-boot-docker-compose — we use Kubernetes (Minikube/Kind)
            for local dev too. See k8s/ folder and README.md.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ── Test ─────────────────────────────────────────── -->
        <!--
            Versions are also managed by the testcontainers-bom import in the
            root POM, but are declared explicitly here so Maven can resolve them
            during the reactor scan phase before the BOM is fetched from the
            remote repository (cold-cache CI runs would otherwise fail).
            ${testcontainers.version} is the single source of truth — it is
            declared once in the root POM's <properties>.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        Override the root POM's default <skip>true</skip>.
                        bootstrap is the only deployable module and must produce
                        a runnable Spring Boot artifact.
                    -->
                    <skip>false</skip>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!--
                        Native Docker image via Paketo buildpacks.
                        Pushed to registry, then pulled by K8s.
                        mvn -Pnative spring-boot:build-image -pl bootstrap -am

                        Override image name for your registry:
                          -Dspring-boot.build-image.imageName=your-registry/hotel-backend:tag
                    -->
                    <image>
                        <!--
                            Do NOT set <name> here. The image name is supplied
                            at build time via:
                              -Dspring-boot.build-image.imageName=ghcr.io/<owner>/hotel-backend:<sha>
                            Hardcoding a name here would override the CLI property
                            and break the CI push step (Run #18 regression).
                        -->
                        <env>
                            <BP_NATIVE_IMAGE>true</BP_NATIVE_IMAGE>
                            <BP_JVM_VERSION>25</BP_JVM_VERSION>
                        </env>
                    </image>
                </configuration>
                <executions>
                    <execution>
                        <id>process-aot</id>
                        <goals>
                            <goal>process-aot</goal>
                        </goals>
                        <configuration>
                            <!--
                                Change 4: Disable schema validation and Flyway during AOT.

                                WHY: During `mvn process-aot`, Spring Boot starts a partial
                                application context to introspect beans and generate AOT artifacts.
                                Hibernate's ddl-auto=validate tries to connect to the DB and
                                validate the schema — but no DB is available during the build.
                                Flyway also tries to run migrations. Both must be disabled
                                for the AOT phase only. They run normally at actual runtime.

                                These JVM args are ONLY applied during the process-aot Maven
                                execution — not at runtime. The application.yml values
                                (validate + flyway enabled) are used at actual startup.
                            -->
                            <jvmArguments>
                                -Dspring.jpa.hibernate.ddl-auto=none
                                -Dspring.jpa.properties.hibernate.hbm2ddl.auto=none
                                -Dspring.flyway.enabled=false
                                -Dspring.datasource.url=jdbc:postgresql://localhost:5432/hotel_db_aot_placeholder
                                -Dspring.datasource.username=placeholder
                                -Dspring.datasource.password=placeholder
                            </jvmArguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <mainClass>id.co.hospitops.bootstrap.HospitOpsApplication</mainClass>
                    <imageName>hospitops-backend</imageName>
                    <buildArgs>
                        <buildArg>--no-fallback</buildArg>
                        <buildArg>-march=compatibility</buildArg>
                        <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                        <buildArg>--initialize-at-build-time=org.slf4j</buildArg>
                        <buildArg>--initialize-at-run-time=org.hibernate.engine.jdbc.dialect.internal</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
