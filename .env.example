# ═══════════════════════════════════════════════════════════════
# .env.example — Docker Compose + IDE environment template
#
# Copy this file to .env at the repo root:
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.
#
# Generate a strong JWT secret:
#   openssl rand -base64 48
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL (Docker Compose initialises the container with these) ─
POSTGRES_DB=hotel_db
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=yourpassword

# ── Spring Boot DB connection (used directly by the app) ─────
# Docker Compose maps the POSTGRES_* vars above into these for the
# app container. When running from an IDE, Spring Boot reads these
# directly — so they must be present in .env and must match the
# POSTGRES_* values above.
DB_URL=jdbc:postgresql://localhost:5432/hotel_db
DB_USER=hotel_user
DB_PASS=yourpassword

# ── HikariCP connection pool ─────────────────────────────────
DB_POOL_MAX=15

# ── JWT ──────────────────────────────────────────────────────
# Minimum 32 characters. The app validates this at startup and
# refuses to start if the key is too short.
JWT_SECRET=dev-local-jwt-secret-change-in-production-min-32

# Token TTL in milliseconds (28800000 = 8 hours)
JWT_EXPIRATION_MS=28800000

# ── Logging ──────────────────────────────────────────────────
# The dev Spring profile already enables SQL + Hibernate bind logging.
# Set to INFO if the SQL output is too noisy for your workflow.
LOG_LEVEL=DEBUG
