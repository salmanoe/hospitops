# ═══════════════════════════════════════════════════════════════
# .env.prod.example — Production environment template (VPS)
#
# Copy to .env.prod and fill in REAL secrets:
#   cp .env.prod.example .env.prod
#
# .env.prod is gitignored — never commit it. Bring the stack up with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Generate strong secrets:
#   JWT_SECRET       → openssl rand -base64 48
#   *_PASSWORD       → openssl rand -base64 24
# ═══════════════════════════════════════════════════════════════

# ── Domain & TLS ─────────────────────────────────────────────
# DNS A/AAAA record for this domain must point at the VPS public IP
# BEFORE first boot, or Let's Encrypt validation fails.
DOMAIN=hospitops.example.com
ACME_EMAIL=ops@example.com

# ── Backend image ────────────────────────────────────────────
# GitHub org/user that owns the GHCR image (ghcr.io/<owner>/hotel-backend).
GHCR_OWNER=salmanoe
# Image tag to run: a commit SHA (recommended for reproducible deploys)
# or "latest" (main branch HEAD). Pin to a SHA in production.
APP_IMAGE_TAG=latest

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=hospitops
POSTGRES_USER=hospitops
# CHANGE THIS — openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-db-password
DB_POOL_MAX=15

# ── Redis (token blacklist) ──────────────────────────────────
# CHANGE THIS — openssl rand -base64 24
REDIS_PASSWORD=change-me-strong-redis-password

# ── JWT ──────────────────────────────────────────────────────
# MUST be >= 32 chars and cryptographically random. The app refuses to
# start otherwise. Rotating this invalidates all active sessions.
#   openssl rand -base64 48
JWT_SECRET=change-me-run-openssl-rand-base64-48
JWT_EXPIRATION_MS=28800000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=false

# ── Automated backups (postgres-backup-local) ────────────────
# SCHEDULE uses go-cron syntax or shortcuts (@daily, @hourly).
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
